# Build tool versions, shared by both workflows and the local scripts, so a CI
# build and a local one use the same Theos and cyan. Plain KEY=value lines only:
# CI reads them with sed, not by sourcing this file.
#
# Bump deliberately, together with the submodules (see
# .github/skills/update-submodules), and build locally before pushing:
#   git ls-remote https://github.com/theos/theos.git HEAD
#   git ls-remote --tags https://github.com/asdfzxcvbn/pyzule-rw.git
#
# Locally, scripts/env.sh warns when ~/theos is on another commit, and
# scripts/build-ipa.sh when the installed cyan is another version.

# theos/theos commit (full SHA).
THEOS_REF=304e0799973e8145f32e4ca2de6c747a84b758ce

# asdfzxcvbn/pyzule-rw release tag; `cyan --version` prints it.
CYAN_REF=v1.4.4
